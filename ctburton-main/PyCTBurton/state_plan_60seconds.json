                "upper_bound": 1800
            }
        },
        "temporal": {
            "ShutdownWithin600": {
                "accepting_event1_constraint": "projl[i]==projOn /\\ projl[i+1]==projConfirm",
                "accepting_event2_constraint": "projl[i+1]==projOff /\\ connl[i+1]==disconnected /\\ compl[i+1]=compOff /\\ temporalAcceptConstraint_Traj_ShutdownWithin600[i]==tempActive",
                "lower_bound": 600,
                "upper_bound": 600
            },
            "ProjectorOnWithin60": {
                "accepting_event1_constraint": "projl[i]==projOff /\\ projl[i+1]==projWarmUp",
                "accepting_event2_constraint": "projl[i+1]==projOn",
                "lower_bound": 0,
                "upper_bound": 60
            }
        },
        "event": {
 
        }
    }
