(define (problem lng-offtake-optimization-problem)
  (:domain lng-offtake-optimization)
  (:objects 
    train1 train2 - train 
    tankA tankB tankC - tank 
    vessel1 vessel2 - vessel 
    cargo1 cargo2 cargo3 cargo4 cargo5 - cargo 
    berth1 - berth 
    time1 time2 time3 - time 
    quality1 quality2 - quality 
    opportunity1 opportunity2 opportunity3 opportunity4 opportunity5 - opportunity 
  )
  (:init 
    (train1-blend-ratio) 
    (train2-blend-ratio) 
    (train1-production-rate) 
    (train2-production-rate) 
    (train1-hhv) 
    (train2-hhv) 
    (field2-ramp-up) 
    (field1-ramp-down) 
    (tank-a-capacity) 
    (tank-b-capacity) 
    (tank-c-capacity) 
    (tank-connectivity) 
    (tank-withdrawal) 
    (tank-top-risk) 
    (operational-buffer) 
    (boil-off-cost) 
    (berth-capacity) 
    (berth-turnaround) 
    (loading-rate) 
    (tidal-windows) 
    (demurrage-cost) 
    (term-contracts) 
    (term-laycan-windows) 
    (term-laycan-compliance) 
    (spot-opportunities) 
    (spot-prices) 
    (spot-acceptance-probability) 
    (spot-decision) 
    (hhv-specification) 
    (hhv-compliance-probability) 
    (hhv-penalty) 
    (cargo-hhv) 
    (tank-hhv-evolution) 
    (planning-horizon) 
    (time-discretization) 
    (vessel-eta-uncertainty) 
    (uncertainty1) 
    (uncertainty2) 
    (uncertainty3) 
    (uncertainty4) 
    (uncertainty5) 
    (uncertainty6) 
    (objectives)
  )
  (:goal 
    (:probability 1.0 
      (objectives))))