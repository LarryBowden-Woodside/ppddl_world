(define (domain lng-offtake-optimization)
  (:requirements :strips :typing :negation :equality :conditional-effects :adl)
  (:types
        object
        train 
            tank 
            vessel 
            cargo 
            berth 
            time 
            quality 
            opportunity 
          
    )
  
  (:predicates
        (tank-c-level-safe ?tank - tank)
        (tank-b-level-safe ?tank - tank)
        (tank-a-level-safe ?tank - tank) 
    (train1-blend-ratio) 
    (train2-blend-ratio) 
    (train1-production-rate) 
    (train2-production-rate) 
    (train1-hhv) 
    (train2-hhv) 
    (field2-ramp-up) 
    (field1-ramp-down) 
    (tank-a-capacity) 
    (tank-b-capacity) 
    (tank-c-capacity) 
    (tank-connectivity) 
    (tank-withdrawal) 
    (tank-top-risk) 
    (operational-buffer) 
    (boil-off-cost) 
    (berth-capacity) 
    (berth-turnaround) 
    (loading-rate) 
    (tidal-windows) 
    (demurrage-cost) 
    (term-contracts) 
    (term-laycan-windows) 
    (term-laycan-compliance) 
    (spot-opportunities) 
    (spot-prices) 
    (spot-acceptance-probability) 
    (spot-decision) 
    (hhv-specification) 
    (hhv-compliance-probability) 
    (hhv-penalty) 
    (cargo-hhv) 
    (tank-hhv-evolution) 
    (planning-horizon) 
    (time-discretization) 
    (vessel-eta-uncertainty) 
    (uncertainty1) 
    (uncertainty2) 
    (uncertainty3) 
    (uncertainty4) 
    (uncertainty5) 
    (uncertainty6) 
    (objectives)
  )

  (:action enforce-train1-blend-ratio
    :precondition (and)
    :effect (train1-blend-ratio)
  )

  (:action enforce-train2-blend-ratio
    :precondition (and)
    :effect (train2-blend-ratio)
  )

  (:action enforce-train1-production-rate
    :precondition (and)
    :effect (train1-production-rate)
  )

  (:action enforce-train2-production-rate
    :precondition (and)
    :effect (train2-production-rate)
  )

  (:action enforce-train1-hhv
    :precondition (and)
    :effect (train1-hhv)
  )

  (:action enforce-train2-hhv
    :precondition (and)
    :effect (train2-hhv)
  )

  (:action enforce-field2-ramp-up
    :precondition (and)
    :effect (field2-ramp-up)
  )

  (:action enforce-field1-ramp-down
    :precondition (and)
    :effect (field1-ramp-down)
  )

  (:action enforce-tank-a-capacity
    :precondition (and)
    :effect (tank-a-capacity)
  )

  (:action enforce-tank-b-capacity
    :precondition (and)
    :effect (tank-b-capacity)
  )

  (:action enforce-tank-c-capacity
    :precondition (and)
    :effect (tank-c-capacity)
  )

  (:action enforce-tank-connectivity
    :precondition (and)
    :effect (tank-connectivity)
  )

  (:action enforce-tank-withdrawal
    :precondition (and)
    :effect (tank-withdrawal)
  )

  (:action enforce-tank-top-risk
    :precondition (and)
    :effect (tank-top-risk)
  )

  (:action enforce-operational-buffer
    :precondition (and)
    :effect (operational-buffer)
  )

  (:action enforce-boil-off-cost
    :precondition (and)
    :effect (boil-off-cost)
  )

  (:action enforce-berth-capacity
    :precondition (and)
    :effect (berth-capacity)
  )

  (:action enforce-berth-turnaround
    :precondition (and)
    :effect (berth-turnaround)
  )

  (:action enforce-loading-rate
    :precondition (and)
    :effect (loading-rate)
  )

  (:action enforce-tidal-windows
    :precondition (and)
    :effect (tidal-windows)
  )

  (:action enforce-demurrage-cost
    :precondition (and)
    :effect (demurrage-cost)
  )

  (:action enforce-term-contracts
    :precondition (and)
    :effect (term-contracts)
  )

  (:action enforce-term-laycan-windows
    :precondition (and)
    :effect (term-laycan-windows)
  )

  (:action enforce-term-laycan-compliance
    :precondition (and)
    :effect (term-laycan-compliance)
  )

  (:action enforce-spot-opportunities
    :precondition (and)
    :effect (spot-opportunities)
  )

  (:action enforce-spot-prices
    :precondition (and)
    :effect (spot-prices)
  )

  (:action enforce-spot-acceptance-probability
    :precondition (and)
    :effect (spot-acceptance-probability)
  )

  (:action enforce-spot-decision
    :precondition (and)
    :effect (spot-decision)
  )

  (:action enforce-hhv-specification
    :precondition (and)
    :effect (hhv-specification)
  )

  (:action enforce-hhv-compliance-probability
    :precondition (and)
    :effect (hhv-compliance-probability)
  )

  (:action enforce-hhv-penalty
    :precondition (and)
    :effect (hhv-penalty)
  )

  (:action enforce-cargo-hhv
    :precondition (and)
    :effect (cargo-hhv)
  )

  (:action enforce-tank-hhv-evolution
    :precondition (and)
    :effect (tank-hhv-evolution)
  )

  (:action enforce-planning-horizon
    :precondition (and)
    :effect (planning-horizon)
  )

  (:action enforce-time-discretization
    :precondition (and)
    :effect (time-discretization)
  )

  (:action enforce-vessel-eta-uncertainty
    :precondition (and)
    :effect (vessel-eta-uncertainty)
  )

  (:action enforce-uncertainty1
    :precondition (and)
    :effect (uncertainty1)
  )

  (:action enforce-uncertainty2
    :precondition (and)
    :effect (uncertainty2)
  )

  (:action enforce-uncertainty3
    :precondition (and)
    :effect (uncertainty3)
  )

  (:action enforce-uncertainty4
    :precondition (and)
    :effect (uncertainty4)
  )

  (:action enforce-uncertainty5
    :precondition (and)
    :effect (uncertainty5)
  )

  (:action enforce-uncertainty6
    :precondition (and)
    :effect (uncertainty6)
  )

  (:action enforce-objectives
    :precondition (and)
    :effect (objectives)
  )
)